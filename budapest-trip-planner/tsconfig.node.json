{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "composite": true,
    "outDir": "./node_modules/.tsbuild",
    "strict": true
  },
  "include": ["vite.config.ts"]
}
