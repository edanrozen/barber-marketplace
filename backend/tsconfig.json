{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "common/**/*.ts", "modules/**/*.ts", "workers/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
