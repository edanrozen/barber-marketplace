# Copy to .env for LOCAL development only (.env is gitignored). NEVER commit real values.
# In staging/production these are injected from AWS Secrets Manager (see below) — not from a .env file.

NODE_ENV=development
PORT=3000

# --- Injected from AWS Secrets Manager in deployed environments (do NOT put real values here) ---
# Secret containers are defined in infrastructure/terraform/modules/secrets.
# Injection pattern: ECS task definition maps each secret ARN to an env var via
# `secrets: [{ name, valueFrom: <secret-arn> }]` (wired when the app reads them, per module TDDs).
DATABASE_URL=            # RDS Postgres — RDS-managed master secret (Secrets Manager)
REDIS_URL=               # ElastiCache Redis
OTP_SMS_GATEWAY_KEY=     # Israeli SMS/OTP gateway
PAYMENT_PROCESSOR_KEY=   # local IL processor (cards + Bit)
E_INVOICING_KEY=         # Green Invoice / iCount
GOOGLE_MAPS_API_KEY=     # geocoding / travel
PUSH_FCM_APNS_KEY=       # Expo Push / FCM / APNs
TRANSACTIONAL_EMAIL_KEY= # transactional email
APP_JWT_SIGNING_KEY=     # own-built auth token signing
